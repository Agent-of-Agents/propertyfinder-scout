# Ключ провайдера модели.
ANTHROPIC_API_KEY=

# Модель в формате provider:model.
AGENT_MODEL=anthropic:claude-opus-5

# Ретраи.
AGENT_MAX_MODEL_RETRIES=3
AGENT_MAX_TOOL_RETRIES=2

# --- Telegram: точка входа в контейнере (bot.py) ---
# Токен от @BotFather. Свой у каждого агента.
TELEGRAM_BOT_TOKEN=
# Кому разрешено писать боту, ID через запятую. Пусто = никому.
ALLOWED_USER_IDS=

# --- Память сессий (memory.py) ---
# Строка подключения к MongoDB. Пусто = диалог не переживёт перезапуск.
MONGODB_URI=
# База этого агента. У каждого агента своя.
MONGODB_DB=propertyfinder-scout
# Через сколько секунд забывать диалог. Пусто = хранить вечно.
AGENT_MEMORY_TTL_SECONDS=

# --- Scout Dubai: Google через сервисный аккаунт (lib/google_auth.py) ---
# Путь к JSON-ключу сервисного аккаунта. На сервере — секрет контейнера.
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json
# Папка на Общем диске, где создаются книги клиентов и папки с PDF.
DRIVE_FOLDER_ID=

# --- Scout Dubai: Telegram-группа с темами (см. docs/HANDOFF.md §7) ---
# id супергруппы (отрицательное число). Пусто = бот работает в личном чате.
GROUP_ID=
# Часовой пояс и время ежедневного прогона.
TZ=Asia/Dubai
DAILY_RUN_AT=08:00
QUIET_HOURS=22:00-08:00
# Альтернатива пути к файлу — JSON ключа целиком одной строкой (для контейнера).
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Scout Dubai: голосовые через Whisper (scout/transcribe.py) ---
# Ключ OpenAI — только для распознавания речи. Пусто = бот просит текст.
OPENAI_API_KEY=
# Модель распознавания; whisper-1 — надёжный вариант по умолчанию.
WHISPER_MODEL=whisper-1
# Запасной локальный Whisper (пакет faster-whisper, CPU): имя модели, например small. Пусто = выключен.
WHISPER_LOCAL_MODEL=
