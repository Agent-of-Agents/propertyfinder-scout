# Ключ провайдера модели.
ANTHROPIC_API_KEY=

# Модель в формате provider:model.
AGENT_MODEL=anthropic:claude-opus-5

# Ретраи.
AGENT_MAX_MODEL_RETRIES=3
AGENT_MAX_TOOL_RETRIES=2

# --- Telegram: точка входа в контейнере (bot.py) ---
# Токен от @BotFather. Свой у каждого агента.
TELEGRAM_BOT_TOKEN=
# Кому разрешено писать боту, ID через запятую. Пусто = никому.
ALLOWED_USER_IDS=

# --- Память сессий (memory.py) ---
# Строка подключения к MongoDB. Пусто = диалог не переживёт перезапуск.
MONGODB_URI=
# База этого агента. У каждого агента своя.
MONGODB_DB=propertyfinder-scout
# Через сколько секунд забывать диалог. Пусто = хранить вечно.
AGENT_MEMORY_TTL_SECONDS=
